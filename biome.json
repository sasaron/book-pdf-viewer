{
    "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
    "files": {
        "includes": [
            "**",
            "!dist",
            "!node_modules",
            "!deno.lock",
            "!aqua-checksums.json",
            "!tests/fixtures"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "useImportExtensions": "error"
            },
            "suspicious": {
                "noImportCycles": "error",
                "noShadow": "error"
            },
            "style": {
                "noNonNullAssertion": "error",
                "noParameterAssign": "error",
                "useNumberNamespace": "error",
                "useConsistentTypeDefinitions": {
                    "level": "error",
                    "options": { "style": "type" }
                }
            },
            "nursery": {
                "noFloatingPromises": "error",
                "noMisusedPromises": "error"
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
